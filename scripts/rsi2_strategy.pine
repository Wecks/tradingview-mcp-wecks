// =============================================================================
// LARRY CONNORS RSI(2) STRATEGY — RIGOROUS BACKTEST
// Source: chartschool.stockcharts.com/...rsi-2
// Canonical instrument: SPY (SPDR S&P 500 ETF) — Daily
//
// ORIGINAL RULES (Connors)
// -----------------------------------------------------------------------------
//  LONG  : Price > SMA(200) AND RSI(2) < lower threshold (default 10)
//           Exit: price crosses above SMA(5)
//  SHORT : Price < SMA(200) AND RSI(2) > upper threshold (default 90)
//           Exit: price crosses below SMA(5)
//  Connors: NO stop-loss (tested here both with and without)
//
// DESIGN CHOICES
// -----------------------------------------------------------------------------
//  1. INSTRUMENT: SPY Daily — Connors' original test. Results on Forex will
//     differ because the strategy exploits the structural bullish bias of US
//     equity indices.
//
//  2. ENTRY: We enter at the OPEN of the next bar (realistic simulation).
//     No intrabar entry — avoids lookahead bias.
//
//  3. SINGLE POSITION: No new position opened if already in a trade.
//     Connors sometimes pyramids, but we stay conservative for this backtest.
//
//  4. STOP LOSS: Optional (Connors opposes it, but running without SL is risky).
//     Tested with a configurable ATR-based stop.
//
//  5. OPTIMIZATION WITHOUT OVERFITTING: Parameters are exposed (RSI threshold,
//     SMA exit period). We avoid searching for the best parameter on the same
//     period as the backtest → data snooping bias. Values remain close to
//     Connors' originals for fair comparison.
//
// TARGET METRICS
// -----------------------------------------------------------------------------
//  - Minimum Win Rate: TBD (Connors claims ~65–70% on long side only)
//  - Minimum trades: 100 (easy to reach on 10+ years of SPY daily data)
//  - Sharpe ratio > 0.5 for a real edge
//
// LIMITATIONS
// -----------------------------------------------------------------------------
//  - Survivorship bias: SPY exists since 1993, test period = structural bull market.
//    WR will be inflated vs an instrument in a bear trend.
//  - Commission: 0.1% per trade (realistic ETF approximation).
//  - Slippage: 1 tick included.
//  - Connors' "no SL" approach is dangerous in practice (see March 2020: -30%).
// =============================================================================

//@version=6
strategy(
  title             = "Connors RSI(2) Strategy — Optimized",
  shorttitle        = "RSI2-OPT",
  overlay           = true,
  initial_capital   = 10000,
  default_qty_type  = strategy.percent_of_equity,
  default_qty_value = 100,           // 100% of capital (Connors: fully invested)
  commission_type   = strategy.commission.percent,
  commission_value  = 0.05,
  slippage          = 1,
  calc_on_order_fills = false,
  process_orders_on_close = false
)

// =============================================================================
// PARAMETERS
// =============================================================================
grp_sig  = "RSI(2) Signals"
rsi_len     = input.int(2,   "RSI Period",                   group=grp_sig, minval=1,  maxval=20)
rsi_entry_l = input.float(5,  "Long entry threshold (RSI <)", group=grp_sig, minval=1, maxval=40,
               tooltip="Connors strict = 5 (best WR). Connors original = 10 (more trades).")
rsi_entry_s = input.float(95, "Short entry threshold (RSI >)",group=grp_sig, minval=60, maxval=99,
               tooltip="Connors strict = 95.")
rsi_exit_l  = input.float(65, "Long exit (RSI >)",            group=grp_sig, minval=50, maxval=99,
               tooltip="Connors: RSI > 65 = exit long (alternative to SMA5).")
rsi_exit_s  = input.float(35, "Short exit (RSI <)",           group=grp_sig, minval=1,  maxval=50)

grp_ma   = "Moving Averages"
sma200_len  = input.int(200, "Trend SMA (filter)",            group=grp_ma, minval=50,  maxval=300)
sma5_len    = input.int(5,   "Exit SMA (close > SMA)",        group=grp_ma, minval=2,   maxval=20,
               tooltip="Connors: exit when price > SMA(5) for longs.")
exit_method = input.string("Both",  "Exit method", options=["SMA5", "RSI", "Both"],
               group=grp_ma,
               tooltip="SMA5 = exit when price > SMA5 (original Connors) | RSI = exit when RSI > threshold | Both = first reached.")

grp_risk = "Risk Management"
use_sl      = input.bool(false, "Enable Stop Loss",            group=grp_risk,
               tooltip="Connors does NOT recommend a SL. Enable to measure the impact.")
sl_atr_mult = input.float(3.0,  "Stop Loss (× ATR 14)",       group=grp_risk, minval=0.5, maxval=10.0)
use_long    = input.bool(true,  "Enable LONG trades",          group=grp_risk)
use_short   = input.bool(false, "Enable SHORT trades",         group=grp_risk,
               tooltip="Shorting SPY is less reliable (structural bullish bias). Disabled by default.")

grp_vis  = "Display"
show_sma200 = input.bool(true, "Show SMA 200", group=grp_vis)
show_sma5   = input.bool(true, "Show SMA 5",   group=grp_vis)

// =============================================================================
// INDICATORS
// =============================================================================
rsi2   = ta.rsi(close, rsi_len)
sma200 = ta.sma(close, sma200_len)
sma5   = ta.sma(close, sma5_len)
atr14  = ta.atr(14)

above200 = close > sma200
below200 = close < sma200

plot(show_sma200 ? sma200 : na, "SMA 200", color=color.new(color.orange, 0), linewidth=2)
plot(show_sma5   ? sma5   : na, "SMA 5",   color=color.new(color.aqua,   0), linewidth=1)

// =============================================================================
// ENTRY CONDITIONS
// crossunder/crossover extracted to global scope (Pine v6 requirement)
// =============================================================================
rsi_crossed_low  = ta.crossunder(rsi2, rsi_entry_l)
rsi_crossed_high = ta.crossover(rsi2,  rsi_entry_s)

long_condition  = above200 and rsi_crossed_low  and use_long
short_condition = below200 and rsi_crossed_high and use_short

// =============================================================================
// EXIT CONDITIONS
// =============================================================================
// Long exit
exit_long_sma  = close > sma5
exit_long_rsi  = rsi2 > rsi_exit_l
exit_long = switch exit_method
    "SMA5" => exit_long_sma
    "RSI"  => exit_long_rsi
    "Both" => exit_long_sma or exit_long_rsi
    => exit_long_sma

// Short exit
exit_short_sma = close < sma5
exit_short_rsi = rsi2 < rsi_exit_s
exit_short = switch exit_method
    "SMA5" => exit_short_sma
    "RSI"  => exit_short_rsi
    "Both" => exit_short_sma or exit_short_rsi
    => exit_short_sma

// =============================================================================
// ORDER MANAGEMENT
// =============================================================================
var float entry_price = na
var float sl_price    = na

// --- LONG ---
if long_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long, comment="RSI2 oversold")
    entry_price := close
    sl_price    := use_sl ? close - sl_atr_mult * atr14 : na

if strategy.position_size > 0
    if use_sl and not na(sl_price)
        strategy.exit("Long SL", "Long", stop=sl_price, comment="SL")
    if exit_long
        strategy.close("Long", comment="Exit SMA/RSI")

// --- SHORT ---
if short_condition and strategy.position_size == 0
    strategy.entry("Short", strategy.short, comment="RSI2 overbought")
    entry_price := close
    sl_price    := use_sl ? close + sl_atr_mult * atr14 : na

if strategy.position_size < 0
    if use_sl and not na(sl_price)
        strategy.exit("Short SL", "Short", stop=sl_price, comment="SL")
    if exit_short
        strategy.close("Short", comment="Exit SMA/RSI")

// =============================================================================
// SIGNAL VISUALIZATION
// =============================================================================
plotshape(long_condition,  "Long",  shape.labelup,   location.belowbar, color.new(color.lime, 0), text="L", textcolor=color.black, size=size.small)
plotshape(short_condition, "Short", shape.labeldown, location.abovebar, color.new(color.red,  0), text="S", textcolor=color.white, size=size.small)

bgcolor(above200 and rsi2 < rsi_entry_l ? color.new(color.lime, 90) : na, title="Oversold zone")
bgcolor(below200 and rsi2 > rsi_entry_s ? color.new(color.red,  90) : na, title="Overbought zone")

// =============================================================================
// RESULTS TABLE (top-right corner)
// =============================================================================
var table t = table.new(position.top_right, 2, 12,
  border_width=1, border_color=color.gray,
  bgcolor=color.new(color.black, 60))

if barstate.islast
    tot  = strategy.closedtrades
    wins = strategy.wintrades
    loss = strategy.losstrades
    wr   = tot > 0 ? wins / tot * 100 : 0.0
    pf   = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0
    net  = strategy.netprofit
    dd   = strategy.max_drawdown_percent
    // True Sharpe ratio is readable in the Strategy Tester "Performance Summary" tab
    avg_trade = tot > 0 ? net / tot : 0.0

    hdr = color.new(color.navy, 50)
    table.cell(t, 0, 0, "RSI2 CONNORS",     text_color=color.white,  text_size=size.small, bgcolor=hdr)
    table.cell(t, 1, 0, "RESULT",           text_color=color.white,  text_size=size.small, bgcolor=hdr)
    table.cell(t, 0, 1,  "Trades",          text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 1,  str.tostring(tot),
               text_color=tot >= 100 ? color.lime : color.orange, text_size=size.small)
    table.cell(t, 0, 2,  "Win Rate",        text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 2,  str.tostring(wr, "#.1") + "%",
               text_color=wr >= 60 ? color.lime : wr >= 50 ? color.yellow : color.red, text_size=size.small)
    table.cell(t, 0, 3,  "Profit Factor",   text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 3,  str.tostring(pf, "#.##"),
               text_color=pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red, text_size=size.small)
    table.cell(t, 0, 4,  "Net P&L",         text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 4,  str.tostring(net, "#.#") + " USD",
               text_color=net > 0 ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 5,  "Max DD %",        text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 5,  str.tostring(dd, "#.##") + "%",
               text_color=dd < 15 ? color.lime : dd < 30 ? color.yellow : color.red, text_size=size.small)
    table.cell(t, 0, 6,  "Avg P&L / Trade", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 6,  str.tostring(avg_trade, "#.##") + " USD",
               text_color=avg_trade > 0 ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 7,  "W / L",           text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 7,  str.tostring(wins) + " / " + str.tostring(loss),
               text_color=color.silver, text_size=size.small)
    table.cell(t, 0, 8,  "Gross Profit",    text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 8,  str.tostring(strategy.grossprofit, "#.#") + " USD",
               text_color=color.lime, text_size=size.small)
    table.cell(t, 0, 9,  "Gross Loss",      text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 9,  str.tostring(strategy.grossloss, "#.#") + " USD",
               text_color=color.red, text_size=size.small)
    table.cell(t, 0, 10, "RSI threshold",   text_color=color.gray,   text_size=size.small)
    table.cell(t, 1, 10, str.tostring(rsi_entry_l) + " / " + str.tostring(rsi_entry_s),
               text_color=color.gray, text_size=size.small)
    table.cell(t, 0, 11, "Exit method",     text_color=color.gray,   text_size=size.small)
    table.cell(t, 1, 11, exit_method,       text_color=color.gray,   text_size=size.small)
