// =============================================================================
// GAP FILL STRATEGY — SPY Intraday (5 min)
// Source: quantifiedstrategies.com/gap-fill-trading-strategies/
// Author: Larry Connors / Quantified Strategies
//
// ORIGINAL RULES
// -----------------------------------------------------------------------------
//  1. SPY opens with a gap DOWN between -0.15% and -0.6%
//  2. Range filter: (close[D-1] - low[D-1]) / (high[D-1] - low[D-1]) < 0.25
//     → Previous day closed in the bottom quarter of its range (sign of weakness)
//  3. Entry: at MARKET at the open (9:30 AM NY)
//  4. TP: 75% of gap filled = Open + 0.75 × (Close_D-1 - Open)
//  5. EOD exit: forced close at 15:55 if TP not reached
//  6. No intraday stop-loss mentioned in the source
//
// REPORTED RESULTS (source, Jan 2010 – Aug 2012)
//  - 110 signals → 98 winners = 89% WR
//  - Average gain per trade: +0.19%
//
// WHY 5-MIN INSTEAD OF DAILY
// -----------------------------------------------------------------------------
//  On a Daily chart, Pine Script cannot simultaneously simulate:
//    - an entry at the open
//    - an intraday TP (limit order during the day)
//    - an EOD exit at the close
//  5-min solves this: enter at 9:30, TP active all session, EOD close at 15:55.
//  This is also exactly how it would be automated in practice:
//    Pre-market → check range filter. At 9:30 → check gap → send order.
//
// BACKTEST LIMITATIONS
// -----------------------------------------------------------------------------
//  1. request.security() for D data may have a slight bias on the first bar
//     of the day (Pine v6 with lookahead=off is safe).
//  2. Opening slippage: the first 5 minutes of a gap day can be very volatile.
//     Real slippage may exceed 1 tick.
//  3. TradingView Free 5-min data is limited (~2 years). For more history,
//     use a Pro account or alternative data sources.
//  4. The strategy is LONG ONLY. Gap UP is not handled (a mirror strategy
//     is possible but historically less reliable on SPY).
//  5. Survivorship bias: SPY has been in a bull market since 2020. Results
//     during 2008 or 2022 would differ → test on a full cycle if possible.
//
// LIVE AUTOMATION BLUEPRINT
// -----------------------------------------------------------------------------
//  Pre-market (9:00–9:29 AM):
//    - API request: SPY close, high, low from previous day
//    - Compute range filter: (close-low)/(high-low) < 0.25
//  At exactly 9:30:00 AM:
//    - Get opening price (last trade or bid/ask mid)
//    - Compute gap_pct = (open - prev_close) / prev_close * 100
//    - If -0.6 ≤ gap_pct ≤ -0.15 AND range filter OK:
//        - Send MARKET BUY order
//        - Place LIMIT SELL at TP = open + 0.75 × (prev_close - open)
//        - Schedule TIME-BASED CLOSE at 15:55 (cancel if TP hit first)
//  Typical algo commission for ETF: ~$0.005/share (Alpaca, IBKR Lite)
// =============================================================================

//@version=6
strategy(
  title               = "Gap Fill Strategy — SPY 5min",
  shorttitle          = "GAPFILL",
  overlay             = true,
  initial_capital     = 10000,
  default_qty_type    = strategy.percent_of_equity,
  default_qty_value   = 95,          // ~95% of capital deployed (leaves room for fees)
  commission_type     = strategy.commission.percent,
  commission_value    = 0.01,        // 0.01% = very realistic for algo ETF trading
  slippage            = 2,           // 2 ticks = conservative for volatile opens
  calc_on_order_fills = false,
  process_orders_on_close = false
)

// =============================================================================
// PARAMETERS (all exposed for auditability)
// =============================================================================
grp_gap  = "Gap Parameters"
gap_min  = input.float(-0.6,  "Gap min (%)",   group=grp_gap, minval=-5.0,  maxval=-0.01,
            tooltip="Connors original: -0.6%. Gap too large → lower fill probability.")
gap_max  = input.float(-0.15, "Gap max (%)",   group=grp_gap, minval=-2.0,  maxval=-0.01,
            tooltip="Connors original: -0.15%. Gap too small → weak edge.")

grp_flt  = "Filters"
use_range_filter = input.bool(true,  "Previous day range filter",   group=grp_flt,
            tooltip="(close-low)/(high-low) < threshold. Original Connors filter.")
range_thr = input.float(0.25, "Range threshold (<)",                group=grp_flt, minval=0.05, maxval=0.95,
            tooltip="Connors: < 0.25 (close in bottom quarter of range).")
use_sma_filter = input.bool(false, "SMA 200D filter (price > SMA)", group=grp_flt,
            tooltip="Optional: avoid going long during extended bear markets.")
sma200_len = input.int(200, "SMA filter period",                    group=grp_flt, minval=50)

grp_exit = "Exit Parameters"
tp_pct   = input.float(0.75, "TP = X% of gap", group=grp_exit, minval=0.1, maxval=2.0,
            tooltip="Connors: 75% of gap. 100% = full gap fill.")
eod_hour = input.int(15,  "EOD exit hour (hh)",   group=grp_exit, minval=14, maxval=15)
eod_min  = input.int(55,  "EOD exit minute (mm)", group=grp_exit, minval=0,  maxval=59)
use_hard_sl = input.bool(false, "Enable hard Stop Loss", group=grp_exit,
            tooltip="Connors does not recommend a SL. Enable to measure the impact.")
sl_pct   = input.float(1.0, "Stop Loss (% below open)", group=grp_exit, minval=0.1, maxval=5.0)

grp_time = "Day Filter"
trade_monday = input.bool(true,  "Monday",    group=grp_time)
trade_tuesday= input.bool(true,  "Tuesday",   group=grp_time)
trade_wed    = input.bool(true,  "Wednesday", group=grp_time)
trade_thurs  = input.bool(true,  "Thursday",  group=grp_time)
trade_friday = input.bool(true,  "Friday",    group=grp_time)

// =============================================================================
// DAILY DATA FOR GAP AND RANGE FILTER CALCULATION
// request.security() to get D-1 data
// lookahead_off = no future bias (Pine v6 standard)
// =============================================================================
d_close = request.security(syminfo.tickerid, "D", close[1],  lookahead=barmerge.lookahead_off)
d_high  = request.security(syminfo.tickerid, "D", high[1],   lookahead=barmerge.lookahead_off)
d_low   = request.security(syminfo.tickerid, "D", low[1],    lookahead=barmerge.lookahead_off)
d_sma200= request.security(syminfo.tickerid, "D", ta.sma(close, sma200_len), lookahead=barmerge.lookahead_off)

// =============================================================================
// OPENING BAR DETECTION (9:30 AM EST on SPY)
// We only enter on the first bar of the NYSE session
// =============================================================================
is_entry_bar = hour(time, "America/New_York") == 9 and
               minute(time, "America/New_York") == 30 and
               dayofweek != dayofweek.saturday and
               dayofweek != dayofweek.sunday

// =============================================================================
// GAP CALCULATION
// gap_pct < 0 = gap down (market opens below previous close)
// =============================================================================
gap_pct    = (open - d_close) / d_close * 100
is_gap_down = gap_pct >= gap_min and gap_pct <= gap_max

// =============================================================================
// PREVIOUS DAY RANGE FILTER
// (close_D1 - low_D1) / (high_D1 - low_D1) < 0.25
// Interpretation: previous day closed in the bottom quarter of its range
// Signals a weak session ending low → gap down is an overreaction
// =============================================================================
range_j1    = d_high - d_low
range_pos_j1= range_j1 > 0 ? (d_close - d_low) / range_j1 : 0.5
range_ok    = not use_range_filter or range_pos_j1 < range_thr

// =============================================================================
// SMA 200D FILTER (optional)
// =============================================================================
sma_ok = not use_sma_filter or open > d_sma200

// =============================================================================
// DAY OF WEEK FILTER
// =============================================================================
dow = dayofweek
dow_ok = (dow == dayofweek.monday    and trade_monday)  or
         (dow == dayofweek.tuesday   and trade_tuesday) or
         (dow == dayofweek.wednesday and trade_wed)     or
         (dow == dayofweek.thursday  and trade_thurs)   or
         (dow == dayofweek.friday    and trade_friday)

// =============================================================================
// TAKE PROFIT CALCULATION
// TP = open + tp_pct × (prev_close - open)
// Example: -0.3% gap, open = 400, prev_close = 401.2
//     gap absolute = 1.2 pts
//     TP = 400 + 0.75 × 1.2 = 400.9
// =============================================================================
gap_abs  = d_close - open   // positive because gap down (open < d_close)
tp_price = open + tp_pct * gap_abs
sl_price = open * (1 - sl_pct / 100)

// =============================================================================
// ENTRY CONDITION
// =============================================================================
entry_signal = is_entry_bar and is_gap_down and range_ok and sma_ok and dow_ok and
               strategy.position_size == 0 and gap_abs > 0

if entry_signal
    strategy.entry("Long", strategy.long, comment="Gap↓ " + str.tostring(gap_pct, "#.##") + "%")
    strategy.exit("TP", "Long", limit=tp_price, comment="GapFill")
    if use_hard_sl
        strategy.exit("SL", "Long", stop=sl_price, comment="SL")

// =============================================================================
// EOD EXIT (end of session)
// =============================================================================
is_eod = hour(time, "America/New_York") == eod_hour and
         minute(time, "America/New_York") == eod_min

if is_eod and strategy.position_size > 0
    strategy.close("Long", comment="EOD")

// =============================================================================
// VISUALIZATION
// =============================================================================
// Green background on entry bar when signal is active
bgcolor(entry_signal ? color.new(color.lime, 85) : na, title="Entry Bar")

// Entry marker
plotshape(entry_signal, "Entry", shape.labelup, location.belowbar,
          color.new(color.lime, 0), text="GAP↓", textcolor=color.black, size=size.small)

// TP level on entry bar
plot(strategy.position_size > 0 ? tp_price : na, "TP Level",
     color=color.new(color.lime, 30), linewidth=1, style=plot.style_linebr)

// =============================================================================
// RESULTS TABLE
// =============================================================================
var table t = table.new(position.top_right, 2, 13,
  border_width=1, border_color=color.gray,
  bgcolor=color.new(color.black, 65))

if barstate.islast
    tot       = strategy.closedtrades
    wins      = strategy.wintrades
    loss      = strategy.losstrades
    wr        = tot > 0 ? wins / tot * 100 : 0.0
    pf        = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0
    net       = strategy.netprofit
    dd        = strategy.max_drawdown_percent
    avg_trade = tot > 0 ? net / tot : 0.0
    avg_win   = wins > 0 ? strategy.grossprofit / wins : 0.0
    avg_loss  = loss > 0 ? math.abs(strategy.grossloss) / loss : 0.0

    hdr = color.new(color.navy, 50)
    table.cell(t, 0, 0, "GAP FILL (SPY 5min)", text_color=color.white,  text_size=size.small, bgcolor=hdr)
    table.cell(t, 1, 0, "RESULT",              text_color=color.white,  text_size=size.small, bgcolor=hdr)

    table.cell(t, 0, 1,  "Trades",        text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 1,  str.tostring(tot),
               text_color=tot >= 30 ? color.lime : color.orange, text_size=size.small)

    table.cell(t, 0, 2,  "Win Rate",      text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 2,  str.tostring(wr, "#.1") + "%",
               text_color=wr >= 70 ? color.lime : wr >= 55 ? color.yellow : color.red, text_size=size.small)

    table.cell(t, 0, 3,  "Profit Factor", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 3,  str.tostring(pf, "#.##"),
               text_color=pf >= 2.0 ? color.lime : pf >= 1.0 ? color.yellow : color.red, text_size=size.small)

    table.cell(t, 0, 4,  "Net P&L",       text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 4,  str.tostring(net, "#.#") + " USD",
               text_color=net > 0 ? color.lime : color.red, text_size=size.small)

    table.cell(t, 0, 5,  "Max DD %",      text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 5,  str.tostring(dd, "#.##") + "%",
               text_color=dd < 10 ? color.lime : dd < 25 ? color.yellow : color.red, text_size=size.small)

    // Sharpe is readable in the Strategy Tester "Performance Summary" tab (not accessible in Pine v6)
    table.cell(t, 0, 6,  "CAGR approx",   text_color=color.silver, text_size=size.small)
    cagr_approx = tot > 0 ? net / 10000 * 100 : 0.0
    table.cell(t, 1, 6,  str.tostring(cagr_approx, "#.1") + "%",
               text_color=cagr_approx > 0 ? color.lime : color.red, text_size=size.small)

    table.cell(t, 0, 7,  "W / L",         text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 7,  str.tostring(wins) + " / " + str.tostring(loss),
               text_color=color.silver, text_size=size.small)

    table.cell(t, 0, 8,  "Avg win",       text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 8,  str.tostring(avg_win, "#.##") + " USD",
               text_color=color.lime, text_size=size.small)

    table.cell(t, 0, 9,  "Avg loss",      text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 9,  str.tostring(avg_loss, "#.##") + " USD",
               text_color=color.red, text_size=size.small)

    table.cell(t, 0, 10, "Avg P&L / trade", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 10, str.tostring(avg_trade, "#.##") + " USD",
               text_color=avg_trade > 0 ? color.lime : color.red, text_size=size.small)

    table.cell(t, 0, 11, "Gap range",     text_color=color.gray,   text_size=size.small)
    table.cell(t, 1, 11, str.tostring(gap_min) + "% → " + str.tostring(gap_max) + "%",
               text_color=color.gray, text_size=size.small)

    table.cell(t, 0, 12, "Source claim",  text_color=color.gray,   text_size=size.small)
    table.cell(t, 1, 12, "89% WR / +0.19%/tr",
               text_color=color.gray, text_size=size.small)
